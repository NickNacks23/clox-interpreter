// Call-heavy workload with no closures.
fun fib(n) {
  if (n < 2) return n;
  return fib(n - 1) + fib(n - 2);
}
var start = clock();
var result = 0;
for (var i = 0; i < 400; i = i + 1) {
  result = fib(18);
}
print result;              // Expected 2584
print clock() - start;     // Runtime in CPU seconds
