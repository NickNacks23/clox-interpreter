// Calls the same closure repeatedly (few allocations, frequent upvalue access).
fun makeAccumulator() {
  var value = 0;
  fun accumulate(delta) {
    value = value + delta;
    return value;
  }
  return accumulate;
}
var accumulate = makeAccumulator();
var start = clock();
for (var i = 0; i < 200000; i = i + 1) {
  accumulate(1);
}
print accumulate(0);      // Expected 200000
print clock() - start;
